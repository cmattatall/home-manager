{
  "name": "tether-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint 'src/**/*.css' --max-warnings 0",
    "format:check": "prettier --check . ../README.md ../../../.pre-commit-config.yaml",
    "format": "prettier --write . ../README.md ../../../.pre-commit-config.yaml"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.108.2",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "idb": "8.0.4",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8"
  },
  "overrides": {
    "dompurify": "3.4.18"
  }
}
